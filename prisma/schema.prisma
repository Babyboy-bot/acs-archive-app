// Schéma Prisma pour l'application ACS Archive
// Tous les noms sont en français

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Énumération des rôles utilisateurs
enum RoleUtilisateur {
  ADMIN
  GESTIONNAIRE
  EMPLOYE
  CONSULTANT
}

// Modèle Utilisateur
model Utilisateur {
  id                String             @id @default(cuid())
  nom               String
  prenom            String
  email             String             @unique
  motDePasse        String
  role              RoleUtilisateur    @default(EMPLOYE)
  estActif          Boolean            @default(true)
  dateCreation      DateTime           @default(now())
  dateModification  DateTime           @updatedAt
  
  // Relations
  documentsCrees    Document[]         @relation("UtilisateurCreateur")
  journalActivites  JournalActivite[]
  
  @@map("utilisateurs")
}

// Modèle Catégorie de documents
// Structure adaptée à l'archivage ACS
// CLIENT → EXERCICE (Année) → RISQUE → TYPE COURRIER → DOCUMENTS

model Client {
  id            String      @id @default(cuid())
  nom           String      @unique
  numeroClient  String?     @unique
  type          TypeClient  @default(ENTREPRISE)
  email         String?
  telephone     String?
  adresse       String?
  exercices     Exercice[]
  creeLe        DateTime    @default(now())
  modifieLe     DateTime    @updatedAt

  @@map("clients")
}

enum TypeClient {
  ENTREPRISE
  PARTICULIER
}

model Exercice {
  id        String     @id @default(cuid())
  annee     Int
  clientId  String
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  risques   Risque[]
  statut    StatutExercice @default(ACTIF)
  creeLe    DateTime   @default(now())
  modifieLe DateTime   @updatedAt

  @@unique([clientId, annee])
  @@map("exercices")
}

enum StatutExercice {
  ACTIF
  ARCHIVE
  CLOTURE
}

model Risque {
  id          String       @id @default(cuid())
  type        TypeRisque
  numeroPolice String?
  exerciceId  String
  exercice    Exercice     @relation(fields: [exerciceId], references: [id], onDelete: Cascade)
  documents   Document[]
  creeLe      DateTime     @default(now())
  modifieLe   DateTime     @updatedAt

  @@map("risques")
}

enum TypeRisque {
  AUTOMOBILE
  SANTE
  HABITATION
  VIE
  RESPONSABILITE_CIVILE
  AUTRE
}

model Document {
  id               String             @id @default(cuid())
  titre            String
  description      String?
  cheminFichier    String
  typeFichier      String
  tailleFichier    Int
  typeCourrier     TypeCourrier
  risqueId         String
  risque           Risque             @relation(fields: [risqueId], references: [id], onDelete: Cascade)
  auteurId         String
  auteur           Utilisateur        @relation(fields: [auteurId], references: [id])
  dateDocument     DateTime?
  reference        String?
  journalActivites JournalActivite[]
  creeLe           DateTime           @default(now())
  modifieLe        DateTime           @updatedAt

  @@map("documents")
  @@index([risqueId])
  @@index([auteurId])
  @@index([creeLe])
}

enum TypeCourrier {
  ACS_VERS_CLIENT      // Courrier ACS → Client
  ACS_VERS_COMPAGNIE   // Courrier ACS → Compagnie
}

// Énumération des types d'actions
enum TypeAction {
  CREATION
  CONSULTATION
  MODIFICATION
  SUPPRESSION
  TELECHARGEMENT
}

// Modèle Journal d'activité (Audit Trail)
model JournalActivite {
  id               String      @id @default(cuid())
  action           TypeAction
  details          String?
  adresseIp        String?
  dateAction       DateTime    @default(now())
  
  // Relations
  utilisateurId    String
  utilisateur      Utilisateur @relation(fields: [utilisateurId], references: [id])
  documentId       String?
  document         Document?   @relation(fields: [documentId], references: [id])
  
  @@map("journal_activites")
  @@index([utilisateurId])
  @@index([documentId])
  @@index([dateAction])
}
