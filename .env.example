# Configuration de la base de données PostgreSQL
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/acs_archive?schema=public"

# NextAuth
NEXTAUTH_SECRET="votre-secret-nextauth-tres-securise"
NEXTAUTH_URL="http://localhost:3000"

# Activer la recherche sémantique avec sentence-transformers (true/false)
# Attention: augmente significativement le temps de démarrage et la mémoire utilisée
# Avec le volume Docker, les modèles sont persistés et ne sont téléchargés qu'une fois
ENABLE_SEMANTIC_SEARCH=false

# Stockage des fichiers (à configurer plus tard)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_BUCKET_NAME=""
# AWS_REGION=""
