# ============================================
# ACS Archive - Configuration Docker Compose
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs

# --- Django ---
DEBUG=True
SECRET_KEY=votre-cle-secrete-ici
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Base de données PostgreSQL ---
DB_NAME=acs_archive
DB_USER=postgres
DB_PASSWORD=votre-mot-de-passe
DB_HOST=db
DB_PORT=5432

# --- JWT / Auth ---
# Durée de vie du token d'accès en minutes (défaut: 60 = 1 heure)
# Le refresh token dure 30 jours et permet de renouveler automatiquement
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_SECRET_KEY=votre-cle-jwt-ici

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://acs.localhost:8080

# --- LLM (Mistral) ---
ASSISTANT_LLM_ENABLED=true
ASSISTANT_LLM_PROVIDER=mistral
ASSISTANT_LLM_MONTHLY_LIMIT=30000
MISTRAL_API_KEY=votre-cle-mistral-ici
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL_DEFAULT=mistral-medium-latest
MISTRAL_MODEL_ADVANCED=mistral-large-latest
MISTRAL_FORCE_CONNECTION_CLOSE=true
ASSISTANT_LLM_TIMEOUT_MS=30000
MISTRAL_TOTAL_BUDGET_MS=30000
MISTRAL_ATTEMPT_TIMEOUT_MS=8000
MISTRAL_RETRY_MAX=2

# --- OCR (Tesseract) ---
OCR_ENABLED=true
TESSERACT_LANG=fra
OCR_DPI=300

# --- Recherche sémantique ---
ENABLE_SEMANTIC_SEARCH=true

# --- Sentry (optionnel) ---
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://backend:8000/api
