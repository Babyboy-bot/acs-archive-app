# --- Django ---
DEBUG=False
SECRET_KEY=REMPLACER-PAR-UNE-CLE-SECRETE-LONGUE-ET-ALEATOIRE
ALLOWED_HOSTS=assureursconseilservice.com,www.assureursconseilservice.com,backend
# --- Base de données PostgreSQL ---
POSTGRES_DB=acs_archive
POSTGRES_USER=acs_user
POSTGRES_PASSWORD=REMPLACER-PAR-MOT-DE-PASSE-FORT
DB_HOST=db
DB_PORT=5432
# --- JWT / Auth ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_SECRET_KEY=REMPLACER-PAR-UNE-CLE-JWT-DIFFERENTE-DE-SECRET-KEY
# --- CORS ---
CORS_ALLOWED_ORIGINS=https://assureursconseilservice.com,https://www.assureursconseilservice.com
# --- LLM (Mistral) ---
ASSISTANT_LLM_ENABLED=true
ASSISTANT_LLM_PROVIDER=mistral
ASSISTANT_LLM_MONTHLY_LIMIT=30000
MISTRAL_API_KEY=votre-cle-mistral-ici
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL_DEFAULT=mistral-medium-latest
MISTRAL_MODEL_ADVANCED=mistral-large-latest
MISTRAL_FORCE_CONNECTION_CLOSE=true
ASSISTANT_LLM_TIMEOUT_MS=30000
MISTRAL_TOTAL_BUDGET_MS=30000
MISTRAL_ATTEMPT_TIMEOUT_MS=8000
MISTRAL_RETRY_MAX=2
# --- OCR (Tesseract) ---
OCR_ENABLED=true
TESSERACT_LANG=fra
OCR_DPI=300
# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=/api
INTERNAL_API_BASE_URL=http://backend:8000/api
