# ============================================================================
# ACS Archive - Backend Environment Variables
# ============================================================================
# Copiez ce fichier vers .env et remplissez les valeurs
# cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# DJANGO CORE
# ----------------------------------------------------------------------------

# Clé secrète Django (OBLIGATOIRE en production)
# Générer avec: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# Mode debug (False en production)
DEBUG=True

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------------------------
# BASE DE DONNÉES
# ----------------------------------------------------------------------------

# URL de connexion PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://acs_user:acs_password@localhost:5432/acs_archive

# Ou variables séparées (alternative)
# POSTGRES_DB=acs_archive
# POSTGRES_USER=acs_user
# POSTGRES_PASSWORD=acs_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ----------------------------------------------------------------------------

# Origines autorisées pour les requêtes CORS (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------------------------------------
# ASSISTANT IA / LLM
# ----------------------------------------------------------------------------

# Activer l'assistant LLM (true/false)
ASSISTANT_LLM_ENABLED=false

# Provider LLM (claude, mistral, openai)
ASSISTANT_LLM_PROVIDER=

# Clé API Claude (Anthropic)
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com/v1

# Clé API Mistral
MISTRAL_API_KEY=

# Clé API OpenAI (optionnel)
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# SÉCURITÉ
# ----------------------------------------------------------------------------

# Durée de vie du token JWT (en secondes, défaut: 86400 = 24h)
JWT_ACCESS_TOKEN_LIFETIME=86400

# Durée de vie du refresh token (en secondes, défaut: 604800 = 7 jours)
JWT_REFRESH_TOKEN_LIFETIME=604800

# ----------------------------------------------------------------------------
# STOCKAGE FICHIERS
# ----------------------------------------------------------------------------

# Répertoire de stockage des documents uploadés
MEDIA_ROOT=/app/media

# URL publique des fichiers média
MEDIA_URL=/media/

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------

# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# MONITORING (Sentry)
# ----------------------------------------------------------------------------

# DSN Sentry pour le tracking d'erreurs (optionnel)
# Créer un compte gratuit sur https://sentry.io
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Environnement Sentry (development, staging, production)
# SENTRY_ENVIRONMENT=development

# Taux d'échantillonnage des traces (0.0 à 1.0)
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ----------------------------------------------------------------------------
# PRODUCTION UNIQUEMENT
# ----------------------------------------------------------------------------

# Forcer HTTPS
# SECURE_SSL_REDIRECT=True

# Cookie sécurisé
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# HSTS (HTTP Strict Transport Security)
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
