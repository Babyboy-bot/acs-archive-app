# ============================================
# ACS Archive - Backend (Dev Local)
# ============================================
# Copiez ce fichier en .env pour le dev local sans Docker

# --- Django ---
SECRET_KEY=votre-cle-secrete-ici
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données PostgreSQL ---
DB_NAME=acs_archive
DB_USER=postgres
DB_PASSWORD=votre-mot-de-passe
DB_HOST=localhost
DB_PORT=5432

# --- JWT / Auth ---
# Durée de vie du token d'accès en minutes (défaut: 60 = 1 heure)
# Le refresh token dure 30 jours et permet de renouveler automatiquement
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_SECRET_KEY=votre-cle-jwt-ici

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM (Mistral) ---
ASSISTANT_LLM_ENABLED=true
ASSISTANT_LLM_PROVIDER=mistral
ASSISTANT_LLM_MONTHLY_LIMIT=30000
MISTRAL_API_KEY=votre-cle-mistral-ici
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL_DEFAULT=mistral-medium-latest
MISTRAL_MODEL_ADVANCED=mistral-large-latest

# --- OCR (Tesseract - chemin Windows) ---
OCR_ENABLED=true
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=fra
OCR_DPI=300

# --- Recherche sémantique ---
ENABLE_SEMANTIC_SEARCH=true

# --- Sentry (optionnel) ---
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
