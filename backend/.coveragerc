[run]
source = .
omit =
    manage.py
    api/tests.py
    api/ocr.py
    api/chunking.py
    api/management/*
    */migrations/*
    */settings*.py
    */__pycache__/*
    */wsgi.py
    */asgi.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
