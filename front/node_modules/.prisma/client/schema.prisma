// Schéma Prisma pour l'application ACS Archive
// Tous les noms sont en français

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Énumération des rôles utilisateurs
enum RoleUtilisateur {
  ADMIN
  GESTIONNAIRE
  EMPLOYE
  CONSULTANT
}

// Modèle Utilisateur
model Utilisateur {
  id                String          @id @default(cuid())
  nomUtilisateur    String          @unique // Connexion par nom d'utilisateur
  nom               String
  prenom            String
  email             String? // Optionnel
  motDePasse        String
  role              RoleUtilisateur @default(EMPLOYE)
  estActif          Boolean         @default(true)
  dateCreation      DateTime        @default(now())
  dateModification  DateTime        @updatedAt
  derniereConnexion DateTime?

  // Relations
  documents        Document[]
  journalActivites JournalActivite[]

  @@map("utilisateurs")
}

// Modèle Catégorie de documents
// Structure adaptée à l'archivage ACS
// CLIENT → EXERCICE (Année) → RISQUE → TYPE COURRIER → DOCUMENTS

model Client {
  id           String     @id @default(cuid())
  nom          String     @unique
  numeroClient String?    @unique
  type         TypeClient @default(ENTREPRISE)
  email        String?
  telephone    String?
  adresse      String?
  exercices    Exercice[]
  creeLe       DateTime   @default(now())
  modifieLe    DateTime   @updatedAt

  @@map("clients")
}

enum TypeClient {
  ENTREPRISE
  PARTICULIER
}

model Exercice {
  id        String         @id @default(cuid())
  annee     Int
  clientId  String
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  risques   Risque[]
  statut    StatutExercice @default(ACTIF)
  creeLe    DateTime       @default(now())
  modifieLe DateTime       @updatedAt

  @@unique([clientId, annee])
  @@map("exercices")
}

enum StatutExercice {
  ACTIF
  ARCHIVE
  CLOTURE
}

model Risque {
  id           String     @id @default(cuid())
  type         TypeRisque
  numeroPolice String?
  exerciceId   String
  exercice     Exercice   @relation(fields: [exerciceId], references: [id], onDelete: Cascade)
  documents    Document[]
  creeLe       DateTime   @default(now())
  modifieLe    DateTime   @updatedAt

  @@map("risques")
}

enum TypeRisque {
  AUTOMOBILE
  SANTE
  HABITATION
  VIE
  RESPONSABILITE_CIVILE
  AUTRE
}

model Document {
  id               String            @id @default(cuid())
  titre            String
  description      String?
  cheminFichier    String
  typeFichier      String
  tailleFichier    Int
  typeCourrier     TypeCourrier
  risqueId         String
  risque           Risque            @relation(fields: [risqueId], references: [id], onDelete: Cascade)
  auteurId         String
  auteur           Utilisateur       @relation(fields: [auteurId], references: [id])
  categorieId      String?
  categorie        Categorie?        @relation(fields: [categorieId], references: [id], onDelete: SetNull)
  dateDocument     DateTime?
  reference        String?
  journalActivites JournalActivite[]
  creeLe           DateTime          @default(now())
  modifieLe        DateTime          @updatedAt
  estArchive       Boolean           @default(false) // Archivé automatiquement si ancien
  dateArchivage    DateTime? // Date d'archivage automatique

  @@index([risqueId])
  @@index([auteurId])
  @@index([categorieId])
  @@index([creeLe])
  @@map("documents")
}

model Categorie {
  id          String     @id @default(cuid())
  nom         String     @unique
  description String?
  couleur     String     @default("#D32027")
  documents   Document[]
  creeLe      DateTime   @default(now())
  modifieLe   DateTime   @updatedAt

  @@map("categories")
}

enum TypeCourrier {
  ACS_VERS_CLIENT // Courrier ACS → Client
  ACS_VERS_COMPAGNIE // Courrier ACS → Compagnie
}

// Énumération des types d'actions
enum TypeAction {
  CREATION
  MODIFICATION
  SUPPRESSION
  CONSULTATION
  TELECHARGEMENT
  EXPORT
  ARCHIVAGE_AUTO
  RESTAURATION
}

// Modèle Journal d'activité (Audit Trail)
model JournalActivite {
  id         String     @id @default(cuid())
  action     TypeAction
  details    String?
  adresseIp  String?
  dateAction DateTime   @default(now())

  // Relations
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  documentId    String?
  document      Document?   @relation(fields: [documentId], references: [id])

  @@index([utilisateurId])
  @@index([documentId])
  @@index([dateAction])
  @@map("journal_activites")
}
